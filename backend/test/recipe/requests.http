###

### Get mixable recipes by empty ingredients and query
POST http://localhost:3000/api/recipe/mixable?q=gold
Content-Type: application/json





###

### use areMixable with enough ingredients
POST http://localhost:3000/api/recipe/areMixable
Content-Type: application/json

{
    "ingredients": [
        {
            "name": "Fresh Lime Juice",
            "quantity": 100,
            "unit": "dash",
            "stored_unit": "ml"
        },
        {
            "name": "Prosecco",
            "quantity": 100.0,
            "stored_unit": "ml"
        }
    ],
    "recipes": [
        {
            "name": "custom1",
            "quantity": 5, 
            "ingredients": [
                {
                    "name": "Prosecco",
                    "quantity": 10
                },
                {
                    "name": "Fresh Lime Juice",
                    "quantity": 10
                }
            ] 
        },
                {
            "name": "custom2",
            "quantity": 5, 
            "ingredients": [
                {
                    "name": "Prosecco",
                    "quantity": 10
                },
                {
                    "name": "Fresh Lime Juice",
                    "quantity": 10
                }
            ] 
        }
    ]
    

}







###

### mix  recipe
POST http://localhost:3000/api/recipe/mix
Content-Type: application/json

{
    "name": "Barracuda",
    "factor": 2,
    "ingredients": [
            {
                "name": "Gold Rum",
                "quantity": 40.0,
                "unit": "ml"
            },
            {
                "name": "Galliano",
                "quantity": 15.0,
                "unit": "ml"
            },
            {
                "name": "Fresh Pineapple Juice",
                "quantity": 60.0,
                "unit": "ml"
            },
            {
                "name": "Fresh Lime Juice",
                "quantity": 1,
                "unit": "dash"
            },
            {
                "name": "Prosecco",
                "quantity": 100.0,
                "unit": "cup"
            }
        ]
}