### Get all recipes
GET http://localhost:3000/api/recipe
Accept: application/json

###

### Get mixable recipes by ingredients
POST http://localhost:3000/api/recipe/mixable
Content-Type: application/json

[
            {
                "name": "Gold Rum",
                "quantity": 45.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Galliano",
                "quantity": 15.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Fresh Pineapple Juice",
                "quantity": 60.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Fresh Lime Juice",
                "quantity": 0.62,
                "unit": "dash",
                "stored_unit": "ml"
            },
            {
                "name": "Prosecco",
                "quantity": 100.0,
                "unit": "top up",
                "stored_unit": "ml"
            }
        ]

###

### Get mixable recipes by ingredients and query
POST http://localhost:3000/api/recipe/mixable?q=bar
Content-Type: application/json

[
            {
                "name": "Gold Rum",
                "quantity": 45.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Galliano",
                "quantity": 15.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Fresh Pineapple Juice",
                "quantity": 60.0,
                "unit": "ml",
                "stored_unit": "ml"
            },
            {
                "name": "Fresh Lime Juice",
